{
  "name": "focustrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first WCAG 2.2 accessibility rule engine and runtime focus debugger.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:e2e": "node tools/build-e2e.mjs",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "check": "tsc --noEmit",
    "test": "vitest run --exclude \"tests/e2e/**\"",
    "test:e2e": "playwright test",
    "e2e": "npm run build:e2e && npm run test:e2e",
    "release:check": "npm run standards:validate && npm run check && npm test && npm run build && npm run build:edge && npm run build:firefox",
    "release:check:full": "npm run release:check && npm run e2e",
    "act:sync": "node tools/act-sync.mjs",
    "aria:sync": "node tools/aria-sync.mjs",
    "language:sync": "node tools/language-sync.mjs",
    "standards:sync": "node tools/standards-sync.mjs",
    "standards:validate": "node tools/standards-validate.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "30.0.1",
    "typescript": "^5.8.3",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  }
}

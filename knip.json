{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "entrypoints/*/main.tsx",
    "cli/index.ts",
    "cli/browser-entry.ts",
    "integrations/*.ts",
    "lib/core/index.ts",
    "tests/**/*.test.ts",
    "tests/**/*.spec.ts",
    "tools/**/*.mjs",
    "vite.cli.browser.config.ts",
    "vite.cli.node.config.ts"
  ],
  "project": [
    "entrypoints/**/*.{ts,tsx}",
    "lib/**/*.{ts,tsx}",
    "shared/**/*.{ts,tsx}",
    "cli/**/*.ts",
    "integrations/**/*.ts",
    "tests/**/*.{ts,tsx}",
    "tools/**/*.mjs",
    "*.config.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreUnresolved": [
    "#imports"
  ]
}
